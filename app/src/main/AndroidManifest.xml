<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Install-time (normal) permissions: no dialog is ever shown. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Runtime permission, asked only when "常駐して待つ" or whole-output mode is turned on,
         so the resident notification is visible (as Wavelet asks). Declining changes nothing
         else: the service runs either way. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Install-time too. Only used to resume whole-output mode after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Runtime permission, asked only when 機器プリセット is told to list the paired Bluetooth
         devices, to show their names before they are next connected. Android 11 and older
         need only the install-time BLUETOOTH for that. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Optional, never granted at install: only `adb shell pm grant com.ikoralite
         android.permission.DUMP` enables it. Lets the screen read which effects audioserver
         runs, in which order. Everything else works without it. -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- Not permissions: only makes these kinds of apps visible, for names and the picker. -->
    <queries>
        <!-- Other equalizer apps, listed in the picker. -->
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
        <!-- Apps with a home-screen icon, so an effect's owner can be shown by name. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Music players, so a session can be shown by the player's name. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:name=".IkoraApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/Theme.Ikora">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Opened from a player's "Equalizer" menu (YT Music: Settings > Playback). -->
            <intent-filter>
                <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.CATEGORY_CONTENT_MUSIC" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DevicesActivity"
            android:exported="false" />

        <!-- Players announce the audio session they start and stop playing. -->
        <receiver
            android:name=".SessionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION" />
                <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION" />
                <!-- ikora's own delivery test, sent the same way a player's broadcast is. -->
                <action android:name="com.ikoralite.SELF_TEST" />
            </intent-filter>
        </receiver>

        <!-- Whole-output mode: resume after reboot or update. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Keeps the process (and so the effect) alive: while a session is open, or always in whole-output mode. -->
        <service
            android:name=".EqService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Applies an audio equalizer to another app's playback session" />
        </service>
    </application>
</manifest>
